module test_all_modulos {
	int#(0..13) unsigned_val
	int#(-20..13) signed_val

	int#(5..8) dynamic_mod

	// Power of two optimization
	unsigned_val mod 8
	unsigned_val mod 4
	unsigned_val mod 2
	signed_val mod 8
	signed_val mod 4
	signed_val mod 2
	// mod 1 optimization
	unsigned_val mod 1
	signed_val mod 1

	// Unsigneds
	// No mod needed
	unsigned_val mod 13
	// To conditional assign 0
	unsigned_val + 1 mod 13
	// To conditional subtract 13
	unsigned_val + 2 mod 13
	unsigned_val + 13 mod 13
	// To remainder
	unsigned_val + 14 mod 13

	// Signeds
	// To conditional assign 12
	unsigned_val - 1 mod 13
	// To conditional add 13
	unsigned_val - 2 mod 13
	unsigned_val - 13 mod 13
	// To double remainder
	unsigned_val - 14 mod 13

	// dynamic modulo
	unsigned_val mod dynamic_mod
}

