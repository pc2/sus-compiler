module monotonize_down {
    interface monotonize_down : bool[16] mbf -> bool[16] mtDown
	bool[16] mbf2
	bool[16] mbf4
	bool[16] mbf8

	for int i in 0..16 {
		if i mod 2 == 0 {
			mbf2[i] = mbf[i] | mbf[i+1]
		} else {
			mbf2[i] = mbf[i]
		}
	}

	for int i in 0..16 {
		if i mod 4 < 2 {
			mbf4[i] = mbf2[i] | mbf2[i+2]
		} else {
			mbf4[i] = mbf2[i]
		}
	}

	for int i in 0..16 {
		if i mod 8 < 4 {
			mbf8[i] = mbf4[i] | mbf4[i+4]
		} else {
			mbf8[i] = mbf4[i]
		}
	}

	for int i in 0..16 {
		if i mod 16 < 8 {
			mtDown[i] = mbf8[i] | mbf8[i+8]
		} else {
			mtDown[i] = mbf8[i]
		}
	}
}

