module example_md {
	interface example_md : int#(0..100)[4] factors,
		int#(0..100) add_to ->
		int product,
		int total

	reg int mul0 = factors[0] * factors[1]
	reg int mul1 = factors[2] * factors[3]

	reg product = mul0 * mul1
	reg total = product + add_to
}


