module matrix_vector_mul {
	interface matrix_vector_mul :
		int#(0..100)[6][4] mat, int#(0..100)[4] vec -> int[6] result

	for int row in 0..6 {
		int[4] row_products
		for int col in 0..4 {
			row_products[col] = mat[col][row] * vec[col]
		}
		result[row] = +row_products
	}
}


