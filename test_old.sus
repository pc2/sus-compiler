//timeline (bs -> /, true) | (bs -> v, false)
module first_bit_idx_6 {
    interface first_bit_idx_6 : bool[6] bits -> int first, bool all_zeros
	when bits[0] {
		first = 0
		all_zeros = false
	} else when bits[1] {
		first = 1
		all_zeros = false
	} else when bits[2] {
		first = 2
		all_zeros = false
	} else when bits[3] {
		first = 3
		all_zeros = false
	} else when bits[4] {
		first = 4
		all_zeros = false
	} else when bits[5] {
		first = 5
		all_zeros = false
	} else {
		all_zeros = true
	}

	/*first int i in 0..6 where bits[i] {
		first = i
		all_zeros = false
	} else {
		all_zeros = true
	}*/

}

module first_bit_idx_24 {
    interface first_bit_idx_24 : bool[24] bits -> int first
	int[4] offsets
	bool[4] was_nonzeros

	for int i in 0..4 {
		bool[6] these_bits
		for int j in 0..6 {
			these_bits[j] = bits[i * 6 + j]
		}

		int offset, bool was_nonzero = first_bit_idx_6(these_bits)
		offsets[i] = offset
		was_nonzeros[i] = was_nonzero
	}
}

module permute {
    interface permute : bool[128] mbf, int#(0..100) selected_permutation -> bool[128] permuted_mbf
