module pow17 {
    interface pow17 : int#(0..100) i -> int o
	    int i2  = i   * i
	reg int i4  = i2  * i2
	    int i8  = i4  * i4
	reg int i16 = i8  * i8
	        o   = i16 * i
}


module fibonnaci {
    interface fibonnaci : -> int num
	state int#(0..100) cur = 1
	state int#(0..100) prev = 0


	num = cur + prev mod 100
	prev = cur
	cur = num
}

module blur2 {
	interface blur2 : int#(0..100) data, bool first -> int blurred

	state int prev

	when !first {
		blurred = data + prev mod 100
	}
	prev = data

	gen int a

	gen bool b = true
	gen bool bb = false

	if bb {
		a = 5
	} else {
		a = 3
	}
}


module Tree_Multiply {
    interface Tree_Multiply : int#(0..100)[4] values -> int total
	reg int a = values[0] * values[1]
	reg int b = values[2] * values[3]
	reg total = a * b
}

module Accumulator {
    interface Accumulator : int#(0..100) term, bool done -> int total
    state int tot
	initial tot = 0

    int new_tot = tot + term mod 100
    when done {
        reg total = new_tot
        tot = 0
    } else {
        tot = new_tot
    }
}


//timeline (a, true -> /) | (a, false -> /) .. (a, false -> r)* .. (a, true -> r)
module blur {
    interface blur : int#(0..100) a, bool done -> int result
	state bool working
	initial working = false
	state int prev

	when working {
		reg reg reg result = prev + a // Add a pipeline stage for shits and giggles
	}
	prev = a
	working = !done
}



//timeline (X -> X) .. (/ -> X) .. (/ -> X) .. (/ -> X)
module Unpack4 {
    interface Unpack4 : int#(0..100)[4] packed -> int out_stream
	gen int INITIAL = 0
	gen int A = 1


    state int st
	initial st = 0
    state int[3] stored_packed

    when st == INITIAL {
        out_stream = packed[0]
        stored_packed[0] = packed[1] // Shorthand notation is possible here "stored_packed[0..2] = packed[1..3]"
        stored_packed[1] = packed[2]
        stored_packed[2] = packed[3]
        st = 1
    } else when st == 1 {
        out_stream = stored_packed[0]
        st = 2
    } else when st == 2 {
        out_stream = stored_packed[1]
        st = 3
    } else when st == 3 {
        out_stream = stored_packed[2]
        st = INITIAL // Must restore initial conditions
        //finish // packet is hereby finished.
    }
}

