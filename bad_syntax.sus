module multiply#(int MIN1, int MAX1, int MIN2, int MAX2) : int#(MIN1..MAX1) a, int#(MIN2..MAX2) b -> int r {
	r = a * b
}

// test
module contains_submodule : int#(0..1) a, int b, int c -> int r {
    int tmp = multiply(a, b)
	reg r = tmp + c
}

template<int Size>     
module ExactlyOne : bool[Size] inputs -> bool exactlyOne {
	if Size == 0 {
		exactlyOne = false
	} else if Size == 1 {
	    exactlyOne = inputs[0]
	} else {
	    bool[Size] atLeastOnes
		bool[Size] atLeastTwos
		atLeastOnes[0] = inputs[0]
		atLeastTwos[0] = false
		for i in 1:Size {
			atLeastOnes[i] = atLeastOnes[i-1] | inputs[i]
			atLeastTwos[i] = atLeastTwos[i-1] | atLeastOnes[i-1] & inputs[i]
		}
		exactlyOne = atLeastOnes & !atLeastTwos
	}
}


module parallel_mul_add_reg : int a, int b -> int p, int q {
    reg int a2 = a * a
	reg int a3 = a * a2 + 3
	reg p = a * a3

	reg int b2 = b + b
	reg int b3 = b + b2
	reg q = b + b3

	// UTF-8 Characters support
	Lööwe 老虎

	
}


