module InclusiveAndMultipliedSlices {
	gen int[16] INTS
	for int I in 0..16 {
		INTS[I] = I
	}
	gen int[4] A = INTS[2*..4]
	assert#(C: A[0] == 8)
	assert#(C: A[3] == 11)
	gen int[4] B = INTS[5..=8]
	assert#(C: B[0] == 5)
	assert#(C: B[3] == 8)
	gen int[4] C = INTS[..=3]
	assert#(C: C[3] == 3)
	gen int[3] D = INTS[9 -.. 3]
	assert#(C: D[0] == 7)
	assert#(C: D[2] == 9)
	INTS[3*..4] = [100, 101, 102, 103]
	assert#(C: INTS[12] == 100)
	assert#(C: INTS[15] == 103)

	input bool[32] data'0
	input int#(0..4) i'0
	output bool[8] byte_sel'0 = data[i*..8]
	output bool[4] incl'0 = data[4..=7]
	output bool[32] written'0
	written[i*..8] = byte_sel
	written[8..=11] = incl
}

