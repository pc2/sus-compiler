	assert#(C: -10 % -3 == -1)

	assert#(C: 10 mod 3 == 1)
	assert#(C: -10 mod 3 == 2)
	//assert#(C: -10 mod -3 == 1)
	//assert#(C: 10 mod -3 == -1)

	int#(10..11) a = 10
	int#(3..4) b = 3

	a % b
	-a % b
	a % -b
	-a % -b
}

