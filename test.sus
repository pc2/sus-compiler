module TestGenArrayOps {
	gen int[4] REPEATS = RepeatGen#(T: type int#(0..10), SIZE: 4, V: 7)
	assert#(C: &(REPEATS == [7, 7, 7, 7]))
	gen int[4] REVERSE = ReverseGen#(T: type int#(0..10), SIZE: 4, V: [1,2,3,4])
	assert#(C: &(REVERSE == [4, 3, 2, 1]))
	gen int[4] CONCAT = ConcatGen#(T: type int#(0..10), SIZE_A: 4, SIZE_B: 3, V_A: [1,2,3,4], V_B: [7, 8, 9])
	assert#(C: &(CONCAT == [1, 2, 3, 4, 7, 8, 9]))
}

