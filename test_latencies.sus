module multiply_add_with_latencies {
    interface multiply_add_with_latencies : int#(0..100) a'0, int#(0..100) b'0, int#(0..100) c'0 -> int r'0
    int tmp'1 = multiply(a, b)
	reg r = tmp + c
}

module disjoint_ports {
    interface disjoint_ports : int#(0..100) a, int#(0..100) b, int#(0..100) c -> int result
	reg result = a + b
	// don't touch c
}

module undeteriminable_input_latency {
    interface undeteriminable_input_latency : int#(0..100) a, int#(0..100) b -> int x, int y
	reg int a_d = a
	int t = a_d + b
    reg reg reg int a_dd = a
	reg int t_d = t
    x = t_d + a_dd
    y = t
}

module specified_input_latency {
    interface specified_input_latency : int#(0..100) a'0, int#(0..100) b'1 -> int x, int y
	reg int a_d = a
    int t = a_d + b
    reg reg reg int a_dd = a
	reg int t_d = t
    x = t_d + a_dd
    y = t
}

module determinable_input_latency {
    interface determinable_input_latency : int#(0..100) a, int#(0..100) b -> int x, int y
	reg int a_d = a
    int t = a_d + b
    reg reg int a_dd = a
	reg int t_d = t
    x = t_d + a_dd
    y = t
}

// This module is a copy of ::undeteriminable_input_latency, but it doesn't have an error, because we just assume the latency of the inner nodes to be the earliest possible.
module determinable_because_no_input_output_ports {
    interface determinable_because_no_input_output_ports : int#(0..100) a -> int x
	reg int a_d = a
    int t = a_d
    reg reg reg int a_dd = a
	reg int t_d = t
    x = t_d + a_dd
}

// This module is a copy of ::undeteriminable_input_latency, but it doesn't have an error, because we just assume the latency of the inner nodes to be the earliest possible.
module conflicting_latency_declarations {
    interface conflicting_latency_declarations : int#(0..100) a'0 -> int x'1
